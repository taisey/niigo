{
  "name": "niigo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.js",
    "dev": "node --env-file-if-exists=.env server/main.js",
    "gas:create": "node --env-file-if-exists=.env -e \"process.exit(require('node:child_process').spawnSync('bash', ['scripts/create-gas.sh'], {stdio:'inherit'}).status ?? 1)\"",
    "gas:bootstrap": "node --env-file-if-exists=.env -e \"process.exit(require('node:child_process').spawnSync('bash', ['scripts/bootstrap-gas.sh'], {stdio:'inherit'}).status ?? 1)\"",
    "gas:deploy": "node --env-file-if-exists=.env gas/deploy/publish-source.js",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
