{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {"/api-client/*": ["ui/api-generated/*"]},
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "ui/api-generated/**/*.ts", "gas/deploy/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
