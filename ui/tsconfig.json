{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {"@/*": ["./src/*"]},
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "api-generated/**/*", "vite.config.ts"]
}
